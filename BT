        // Carregar Dados do localStorage
        function loadState() {
            try {
                const storedBooks = localStorage.getItem(STORAGE_KEYS.BOOKS);
                const storedReaders = localStorage.getItem(STORAGE_KEYS.READERS);
                const storedLoans = localStorage.getItem(STORAGE_KEYS.LOANS);

                if (!storedBooks || !storedReaders || !storedLoans) {
                    const initial = getInitialData();
                    state = initial;
                    saveState();
                } else {
                    state.books = JSON.parse(storedBooks);
                    state.readers = JSON.parse(storedReaders);
                    state.loans = JSON.parse(storedLoans);
                }
            } catch (error) {
                console.error('Erro ao carregar dados do localStorage:', error);
                state = getInitialData();
            }
        }

        // Salvar Dados no localStorage
        function saveState() {
            try {
                localStorage.setItem(STORAGE_KEYS.BOOKS, JSON.stringify(state.books));
                localStorage.setItem(STORAGE_KEYS.READERS, JSON.stringify(state.readers));
                localStorage.setItem(STORAGE_KEYS.LOANS, JSON.stringify(state.loans));
            } catch (error) {
                console.error('Erro ao salvar dados:', error);
                showToast('Erro ao salvar alterações no navegador.', 'error');
            }
        }

        // Restaurar Dados Iniciais
        function resetDemoData() {
            state = getInitialData();
            saveState();
            renderAll();
            closeConfirmModal();
            showToast('Dados de demonstração restaurados com sucesso!', 'success');
        }

        // ==================== NOTIFICAÇÕES TOAST ====================
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const styles = {
                success: 'bg-slate-900 text-white border-l-4 border-emerald-500',
                error: 'bg-slate-900 text-white border-l-4 border-red-500',
                info: 'bg-slate-900 text-white border-l-4 border-amber-500'
            };

            const icons = {
                success: '<i class="fa-solid fa-circle-check text-emerald-400"></i>',
                error: '<i class="fa-solid fa-circle-exclamation text-red-400"></i>',
                info: '<i class="fa-solid fa-circle-info text-amber-400"></i>'
            };

            toast.className = `${styles[type] || styles.info} px-4 py-3 rounded-xl shadow-xl flex items-center gap-3 text-sm font-medium pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0`;
            toast.innerHTML = `${icons[type] || icons.info} <span>${message}</span>`;

            container.appendChild(toast);

            // Animar entrada
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            // Remover após 3.5s
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

