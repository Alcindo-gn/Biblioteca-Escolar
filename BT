        function openConfirmModal(title, message, onConfirmCallback) {
            document.getElementById('confirm-title').textContent = title;
            document.getElementById('confirm-message').textContent = message;
            
            const confirmBtn = document.getElementById('confirm-action-btn');
            confirmBtn.onclick = () => {
                onConfirmCallback();
            };

            const modal = document.getElementById('confirm-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeConfirmModal() {
            const modal = document.getElementById('confirm-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // ==================== NAVEGAÇÃO ENTRE ABAS ====================
        function switchTab(tabName) {
            // Ocultar todas as seções
            document.querySelectorAll('.tab-content').forEach(section => {
                section.classList.add('hidden');
            });

            // Mostrar seção selecionada
            const target = document.getElementById(`tab-${tabName}`);
            if (target) target.classList.remove('hidden');

            // Atualizar botões Desktop
            document.querySelectorAll('.nav-btn').forEach(btn => {
                if (btn.dataset.tab === tabName) {
                    btn.className = 'nav-btn px-4 py-2 rounded-lg text-sm transition-colors flex items-center gap-2 bg-amber-500 text-slate-900 font-semibold';
                } else {
                    btn.className = 'nav-btn px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2';
                }
            });

            // Atualizar botões Mobile
            document.querySelectorAll('.nav-btn-mobile').forEach(btn => {
                if (btn.dataset.tab === tabName) {
                    btn.classList.remove('text-slate-400');
                    btn.classList.add('text-amber-400');
                } else {
                    btn.classList.remove('text-amber-400');
                    btn.classList.add('text-slate-400');
                }
            });

            renderAll();
        }

        // ==================== HELPER DE STATUS DE PRAZO ====================
        function getLoanDueStatus(dueDateStr) {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const [y, m, d] = dueDateStr.split('-').map(Number);
            const due = new Date(y, m - 1, d);
            
            const diffTime = due - today;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays < 0) {
                return {
                    type: 'overdue',
                    label: `Atrasado há ${Math.abs(diffDays)} dia(s)`,
                    badgeClass: 'bg-red-100 text-red-700 border-red-200',
                    cardBorder: 'border-l-4 border-l-red-500 bg-red-50/30'
                };
            } else if (diffDays <= 2) {
                return {
                    type: 'soon',
                    label: diffDays === 0 ? 'Vence hoje!' : `Vence em ${diffDays} dia(s)`,
                    badgeClass: 'bg-amber-100 text-amber-800 border-amber-200',
                    cardBorder: 'border-l-4 border-l-amber-500 bg-amber-50/30'
                };
            } else {
                return {
                    type: 'ok',
                    label: `No prazo (${diffDays} dias)`,
                    badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
                    cardBorder: 'border-l-4 border-l-slate-300'
                };
            }
        }

        // ==================== RENDERIZAÇÃO: DASHBOARD ====================
        function renderDashboard() {
            const totalExemplares = state.books.reduce((acc, b) => acc + Number(b.totalQty), 0);
            const totalDisponiveis = state.books.reduce((acc, b) => acc + Number(b.availableQty), 0);
            const activeLoans = state.loans.filter(l => l.status === 'active');
            const overdueCount = activeLoans.filter(l => getLoanDueStatus(l.dueDate).type === 'overdue').length;

            document.getElementById('stat-total-books').textContent = totalExemplares;
            document.getElementById('stat-unique-titles').textContent = `${state.books.length} título(s) no catálogo`;
            document.getElementById('stat-available-books').textContent = totalDisponiveis;
            document.getElementById('stat-loaned-books').textContent = activeLoans.length;
            document.getElementById('stat-overdue-books').textContent = overdueCount > 0 ? `${overdueCount} em atraso!` : 'Nenhum atraso';
            document.getElementById('stat-overdue-books').className = overdueCount > 0 ? 'text-xs text-red-600 font-semibold mt-1' : 'text-xs text-slate-500 mt-1';
            document.getElementById('stat-total-readers').textContent = state.readers.length;

            // Badge na navbar
            document.getElementById('nav-badge-loans').textContent = activeLoans.length;

            // Lista de Empréstimos no Dashboard
            const dashLoansList = document.getElementById('dashboard-loans-list');
            if (activeLoans.length === 0) {
                dashLoansList.innerHTML = `<p class="text-sm text-slate-400 py-6 text-center">Nenhum empréstimo ativo no momento.</p>`;
            } else {
                // Ordenar por data de vencimento mais próxima
                const sortedLoans = [...activeLoans].sort((a, b) => a.dueDate.localeCompare(b.dueDate)).slice(0, 4);
                dashLoansList.innerHTML = sortedLoans.map(loan => {
                    const status = getLoanDueStatus(loan.dueDate);
                    return `
                        <div class="p-3.5 rounded-xl border border-slate-200/80 ${status.cardBorder} flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div>
                                <p class="font-semibold text-slate-900 text-sm">${escapeHTML(loan.bookTitle)}</p>
                                <p class="text-xs text-slate-500 mt-0.5">
                                    <i class="fa-solid fa-user text-slate-400 mr-1"></i> ${escapeHTML(loan.readerName)} 
                                    <span class="mx-1.5">&bull;</span> 
                                    Entrega: <strong>${formatDisplayDate(loan.dueDate)}</strong>
                                </p>
                            </div>
                            <div class="flex items-center gap-2 self-start sm:self-center">
                                <span class="text-xs font-medium px-2.5 py-1 rounded-full border ${status.badgeClass}">${status.label}</span>
                                <button onclick="returnLoan('${loan.id}')" title="Registrar Devolução" class="text-xs bg-slate-900 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-lg transition-colors">
                                    Devolver
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            // Categorias no Dashboard
            const catContainer = document.getElementById('dashboard-categories-list');
            const categoryCounts = {};
            state.books.forEach(b => {
                categoryCounts[b.category] = (categoryCounts[b.category] || 0) + Number(b.totalQty);
            });

            const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);
            if (categories.length === 0) {
                catContainer.innerHTML = `<p class="text-sm text-slate-400 text-center py-4">Sem livros cadastrados.</p>`;
            } else {
                catContainer.innerHTML = categories.map(([cat, count]) => {
                    const percent = totalExemplares > 0 ? Math.round((count / totalExemplares) * 100) : 0;
                    return `
                        <div>
                            <div class="flex justify-between text-xs font-medium mb-1">
                                <span class="text-slate-700">${escapeHTML(cat)}</span>
                                <span class="text-slate-500">${count} ex. (${percent}%)</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                <div class="bg-slate-800 h-2 rounded-full transition-all duration-500" style="width: ${percent}%"></div>
                            </div>
                        </div>
                    `;
                }).join('');
            }
        }

        // ==================== RENDERIZAÇÃO: CATÁLOGO ====================
        function populateCategoryFilter() {
            const filterSelect = document.getElementById('catalog-category-filter');
            const currentVal = filterSelect.value;
            const categories = [...new Set(state.books.map(b => b.category))].sort();
            
            filterSelect.innerHTML = `<option value="all">Todas as Categorias</option>` + 
                categories.map(c => `<option value="${escapeHTML(c)}">${escapeHTML(c)}</option>`).join('');
            
            if (categories.includes(currentVal)) {
                filterSelect.value = currentVal;
            }
        }

        function renderCatalog() {
            populateCategoryFilter();

            const searchTerm = document.getElementById('catalog-search').value.toLowerCase().trim();
            const categoryFilter = document.getElementById('catalog-category-filter').value;
            const statusFilter = document.getElementById('catalog-status-filter').value;

            const filteredBooks = state.books.filter(book => {
                const matchesSearch = 
                    book.title.toLowerCase().includes(searchTerm) ||
                    book.author.toLowerCase().includes(searchTerm) ||
                    book.isbn.toLowerCase().includes(searchTerm);
                
                const matchesCategory = categoryFilter === 'all' || book.category === categoryFilter;
                
                const matchesStatus = 
                    statusFilter === 'all' ||
                    (statusFilter === 'available' && book.availableQty > 0) ||
                    (statusFilter === 'out' && book.availableQty <= 0);

                return matchesSearch && matchesCategory && matchesStatus;
            });

            const tbody = document.getElementById('catalog-table-body');
            const emptyState = document.getElementById('catalog-empty-state');

            if (filteredBooks.length === 0) {
                tbody.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            tbody.innerHTML = filteredBooks.map(book => {
                const isAvailable = book.availableQty > 0;
                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="py-4 px-6">
                            <p class="font-bold text-slate-900">${escapeHTML(book.title)}</p>
                            <p class="text-xs text-slate-500 mt-0.5">${escapeHTML(book.author)}</p>
                        </td>
                        <td class="py-4 px-4 text-xs font-mono text-slate-600">${escapeHTML(book.isbn)}</td>
                        <td class="py-4 px-4">
                            <span class="inline-block bg-slate-100 text-slate-700 text-xs font-medium px-2.5 py-1 rounded-lg">
                                ${escapeHTML(book.category)}
                            </span>
                        </td>
                        <td class="py-4 px-4 text-center text-slate-600">${book.year}</td>
                        <td class="py-4 px-4 text-center font-semibold text-slate-800">
                            ${book.availableQty} <span class="text-slate-400 font-normal">/ ${book.totalQty}</span>
                        </td>
                        <td class="py-4 px-4 text-center">
                            ${isAvailable 
                                ? `<span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold px-2.5 py-1 rounded-full"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Disponível</span>`
                                : `<span class="inline-flex items-center gap-1.5 bg-red-50 text-red-700 border border-red-200 text-xs font-semibold px-2.5 py-1 rounded-full"><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Esgotado</span>`
                            }
                        </td>
                        <td class="py-4 px-6 text-right">
                            <div class="inline-flex items-center justify-end gap-1.5">
                                <button onclick="quickLoan('${book.id}')" ${!isAvailable ? 'disabled' : ''} title="${isAvailable ? 'Emprestar este livro' : 'Sem exemplares disponíveis'}" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1 ${isAvailable ? 'bg-amber-500 hover:bg-amber-600 text-slate-900' : 'bg-slate-100 text-slate-400 cursor-not-allowed'}">
                                    <i class="fa-solid fa-handshake"></i> <span class="hidden xl:inline">Emprestar</span>
                                </button>
                                <button onclick="openBookModal('${book.id}')" title="Editar livro" class="p-2 text-slate-500 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button onclick="confirmDeleteBook('${book.id}')" title="Excluir livro" class="p-2 text-slate-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // ==================== CRUD DE LIVROS ====================
        function openBookModal(bookId = null) {
            const modal = document.getElementById('book-modal');
            const titleEl = document.getElementById('book-modal-title');
            const form = document.getElementById('book-form');
            form.reset();

            if (bookId) {
                const book = state.books.find(b => b.id === bookId);
                if (!book) return;
                titleEl.innerHTML = `<i class="fa-solid fa-pen-to-square text-amber-400"></i> Editar Livro`;
                document.getElementById('book-id').value = book.id;
                document.getElementById('book-title').value = book.title;
                document.getElementById('book-author').value = book.author;
                document.getElementById('book-isbn').value = book.isbn;
                document.getElementById('book-category').value = book.category;
                document.getElementById('book-year').value = book.year;
                document.getElementById('book-qty').value = book.totalQty;
            } else {
                titleEl.innerHTML = `<i class="fa-solid fa-book text-amber-400"></i> Adicionar Novo Livro`;
                document.getElementById('book-id').value = '';
                document.getElementById('book-year').value = new Date().getFullYear();
                document.getElementById('book-qty').value = 1;
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeBookModal() {
            const modal = document.getElementById('book-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function handleSaveBook(event) {
            event.preventDefault();
            const id = document.getElementById('book-id').value;
            const title = document.getElementById('book-title').value.trim();
            const author = document.getElementById('book-author').value.trim();
            const isbn = document.getElementById('book-isbn').value.trim();
            const category = document.getElementById('book-category').value;
            const year = parseInt(document.getElementById('book-year').value, 10);
            const newTotalQty = parseInt(document.getElementById('book-qty').value, 10);

            if (id) {
                // Editar existente
                const bookIndex = state.books.findIndex(b => b.id === id);
                if (bookIndex !== -1) {
                    const oldBook = state.books[bookIndex];
                    const loanedOut = oldBook.totalQty - oldBook.availableQty;

                    if (newTotalQty < loanedOut) {
                        showToast(`Não é possível reduzir para ${newTotalQty}. Há ${loanedOut} exemplar(es) emprestado(s).`, 'error');
                        return;
                    }

                    state.books[bookIndex] = {
                        ...oldBook,
                        title,
                        author,
                        isbn,
                        category,
                        year,
                        totalQty: newTotalQty,
                        availableQty: newTotalQty - loanedOut
                    };
                    showToast('Livro atualizado com sucesso!', 'success');
                }
            } else {
                // Adicionar novo
                const newBook = {
                    id: 'b_' + Date.now(),
                    title,
                    author,
                    isbn,
                    category,
                    year,
                    totalQty: newTotalQty,
                    availableQty: newTotalQty
                };
                state.books.unshift(newBook);
                showToast('Novo livro adicionado ao catálogo!', 'success');
            }

            saveState();
            closeBookModal();
            renderAll();
        }

        function confirmDeleteBook(bookId) {
            const book = state.books.find(b => b.id === bookId);
            if (!book) return;

            const hasActiveLoans = state.loans.some(l => l.bookId === bookId && l.status === 'active');
            if (hasActiveLoans) {
                showToast('Não é possível excluir um livro que possui empréstimos ativos.', 'error');
                return;
            }

            openConfirmModal(
                'Excluir Livro',
                `Deseja realmente remover "${book.title}" do catálogo? Esta ação não pode ser desfeita.`,
                () => {
                    state.books = state.books.filter(b => b.id !== bookId);
                    saveState();
                    closeConfirmModal();
                    renderAll();
                    showToast('Livro excluído do catálogo.', 'info');
                }
            );
        }

        // Empréstimo Rápido a partir do Catálogo
        function quickLoan(bookId) {
            switchTab('emprestimos');
            const select = document.getElementById('loan-book-select');
            select.value = bookId;
            document.getElementById('loan-reader-input').focus();
            showToast('Livro selecionado! Informe o leitor e confirme.', 'info');
        }

        // ==================== EMPRÉSTIMOS E DEVOLUÇÕES ====================
        function renderLoansSection() {
            // Popular Select de Livros Disponíveis
            const bookSelect = document.getElementById('loan-book-select');
            const availableBooks = state.books.filter(b => b.availableQty > 0);
            
            if (availableBooks.length === 0) {
                bookSelect.innerHTML = `<option value="">Nenhum livro disponível no momento</option>`;
            } else {
                bookSelect.innerHTML = `<option value="">Selecione um livro...</option>` + 
                    availableBooks.map(b => `<option value="${b.id}">${escapeHTML(b.title)} (${b.availableQty} disp.)</option>`).join('');
            }

            // Popular Datalist de Leitores
            const datalist = document.getElementById('readers-datalist');
            datalist.innerHTML = state.readers.map(r => `<option value="${escapeHTML(r.name)}">${escapeHTML(r.registration)}</option>`).join('');

            // Definir data padrão de devolução (+7 dias) se estiver vazio
            const dueDateInput = document.getElementById('loan-due-date');
            if (!dueDateInput.value) {
                dueDateInput.value = getFormattedDateOffset(7);
            }

            // Listar Empréstimos Ativos
            const activeLoans = state.loans.filter(l => l.status === 'active');
            document.getElementById('active-loans-count').textContent = `${activeLoans.length} ativo(s)`;
            
            const activeListEl = document.getElementById('active-loans-list');
            if (activeLoans.length === 0) {
                activeListEl.innerHTML = `
                    <div class="text-center py-8 text-slate-400">
                        <i class="fa-solid fa-check-double text-2xl mb-2 text-emerald-500/50"></i>
                        <p class="text-sm">Todos os livros foram devolvidos! Nenhum empréstimo ativo.</p>
                    </div>
                `;
            } else {
                activeListEl.innerHTML = activeLoans.map(loan => {
                    const status = getLoanDueStatus(loan.dueDate);
                    return `
                        <div class="p-4 rounded-xl border border-slate-200 ${status.cardBorder} flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all">
                            <div class="space-y-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="font-bold text-slate-900 text-sm">${escapeHTML(loan.bookTitle)}</h3>
                                    <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full border ${status.badgeClass}">
                                        ${status.label}
                                    </span>
                                </div>
                                <div class="text-xs text-slate-600 flex flex-wrap gap-x-4 gap-y-1">
                                    <span><i class="fa-solid fa-user text-slate-400 mr-1"></i> <strong>${escapeHTML(loan.readerName)}</strong></span>
                                    <span><i class="fa-regular fa-calendar text-slate-400 mr-1"></i> Retirada: ${formatDisplayDate(loan.loanDate)}</span>
                                    <span><i class="fa-regular fa-calendar-check text-slate-400 mr-1"></i> Devolução: <strong>${formatDisplayDate(loan.dueDate)}</strong></span>
                                </div>
                            </div>
                            <button onclick="returnLoan('${loan.id}')" class="shrink-0 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-sm transition-colors flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-rotate-left"></i> Registrar Devolução
                            </button>
                        </div>
                    `;
                }).join('');
            }

            // Listar Histórico de Devoluções
            const returnedLoans = state.loans.filter(l => l.status === 'returned');
            document.getElementById('returned-loans-count').textContent = `${returnedLoans.length} concluído(s)`;
            
            const returnedTable = document.getElementById('returned-loans-table');
            if (returnedLoans.length === 0) {
                returnedTable.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-slate-400 text-xs">Nenhuma devolução registrada ainda.</td></tr>`;
            } else {
                returnedTable.innerHTML = returnedLoans.slice(0, 15).map(loan => `
                    <tr class="hover:bg-slate-50">
                        <td class="py-3 pr-4 font-medium text-slate-800">${escapeHTML(loan.bookTitle)}</td>
                        <td class="py-3 px-4 text-slate-600">${escapeHTML(loan.readerName)}</td>
                        <td class="py-3 px-4 text-slate-500 text-xs">${formatDisplayDate(loan.loanDate)}</td>
                        <td class="py-3 pl-4 text-right">
                            <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md">
                                <i class="fa-solid fa-check text-[10px]"></i> ${formatDisplayDate(loan.returnDate)}
                            </span>
                        </td>
                    </tr>
                `).join('');
            }
        }

        function handleCreateLoan(event) {
            event.preventDefault();
            const bookId = document.getElementById('loan-book-select').value;
            const readerName = document.getElementById('loan-reader-input').value.trim();
            const dueDate = document.getElementById('loan-due-date').value;

            if (!bookId) {
                showToast('Selecione um livro disponível.', 'error');
                return;
            }

            const bookIndex = state.books.findIndex(b => b.id === bookId);
            if (bookIndex === -1 || state.books[bookIndex].availableQty <= 0) {
                showToast('Este livro não possui exemplares disponíveis.', 'error');
                return;
            }

            // Decrementar estoque disponível
            state.books[bookIndex].availableQty -= 1;

            // Criar registro de empréstimo
            const newLoan = {
                id: 'l_' + Date.now(),
                bookId: bookId,
                bookTitle: state.books[bookIndex].title,
                readerName: readerName,
                loanDate: getFormattedDateOffset(0),
                dueDate: dueDate,
                returnDate: null,
                status: 'active'
            };

            state.loans.unshift(newLoan);
            saveState();

            // Resetar formulário mantendo data padrão +7 dias
            document.getElementById('loan-form').reset();
            document.getElementById('loan-due-date').value = getFormattedDateOffset(7);

            renderAll();
            showToast(`Empréstimo de "${newLoan.bookTitle}" registrado!`, 'success');
        }

        function returnLoan(loanId) {
            const loanIndex = state.loans.findIndex(l => l.id === loanId);
            if (loanIndex === -1) return;

            const loan = state.loans[loanIndex];
            if (loan.status === 'returned') return;

            // Atualizar status do empréstimo
            state.loans[loanIndex].status = 'returned';
            state.loans[loanIndex].returnDate = getFormattedDateOffset(0);

            // Devolver exemplar ao estoque do livro (se o livro ainda existir)
            const bookIndex = state.books.findIndex(b => b.id === loan.bookId);
            if (bookIndex !== -1) {
                state.books[bookIndex].availableQty = Math.min(
                    state.books[bookIndex].totalQty,
                    state.books[bookIndex].availableQty + 1
                );
            }

            saveState();
            renderAll();
            showToast(`Devolução de "${loan.bookTitle}" registrada! Estoque atualizado.`, 'success');
        }

        // ==================== LEITORES (MEMBROS) ====================
        function renderReaders() {
            const search = document.getElementById('reader-search').value.toLowerCase().trim();
            const filtered = state.readers.filter(r => 
                r.name.toLowerCase().includes(search) ||
                r.registration.toLowerCase().includes(search) ||
                r.contact.toLowerCase().includes(search)
            );

            document.getElementById('readers-total-badge').textContent = `${filtered.length} membro(s)`;

            const tbody = document.getElementById('readers-table-body');
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-slate-400 text-sm">Nenhum leitor encontrado.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(reader => {
                // Contar empréstimos ativos deste leitor pelo nome
                const activeCount = state.loans.filter(
                    l => l.status === 'active' && l.readerName.toLowerCase() === reader.name.toLowerCase()
                ).length;

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="py-3.5 px-6">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-slate-900 text-amber-400 font-bold text-xs flex items-center justify-center shrink-0">
                                    ${escapeHTML(reader.name.charAt(0).toUpperCase())}
                                </div>
                                <span class="font-semibold text-slate-900">${escapeHTML(reader.name)}</span>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 font-mono text-xs text-slate-600">${escapeHTML(reader.registration)}</td>
                        <td class="py-3.5 px-4 text-slate-600 text-xs">${escapeHTML(reader.contact)}</td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold ${activeCount > 0 ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-500'}">
                                ${activeCount} livro(s)
                            </span>
                        </td>
                        <td class="py-3.5 px-6 text-right">
                            <button onclick="confirmDeleteReader('${reader.id}')" title="Remover leitor" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function handleCreateReader(event) {
            event.preventDefault();
            const name = document.getElementById('reader-name').value.trim();
            const contact = document.getElementById('reader-contact').value.trim();
            const registration = document.getElementById('reader-registration').value.trim();

            const newReader = {
                id: 'r_' + Date.now(),
                name,
                contact,
                registration
            };

            state.readers.unshift(newReader);
            saveState();
            document.getElementById('reader-form').reset();
            renderAll();
            showToast(`Leitor "${name}" cadastrado com sucesso!`, 'success');
        }

        function confirmDeleteReader(readerId) {
            const reader = state.readers.find(r => r.id === readerId);
            if (!reader) return;

            const hasActiveLoans = state.loans.some(
                l => l.status === 'active' && l.readerName.toLowerCase() === reader.name.toLowerCase()
            );

            if (hasActiveLoans) {
                showToast('Este leitor possui livros emprestados e não pode ser removido.', 'error');
                return;
            }

            openConfirmModal(
                'Remover Leitor',
                `Deseja remover o cadastro de "${reader.name}"?`,
                () => {
                    state.readers = state.readers.filter(r => r.id !== readerId);
                    saveState();
                    closeConfirmModal();
                    renderAll();
                    showToast('Cadastro de leitor removido.', 'info');
                }
            );
        }

        // Sanitização básica para evitar XSS
        function escapeHTML(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // Renderizar toda a interface
        function renderAll() {
            renderDashboard();
            renderCatalog();
            renderLoansSection();
            renderReaders();
        }

        // Inicialização
        window.addEventListener('DOMContentLoaded', () => {
            loadState();
            renderAll();
        });
    </script>
</body>
</html>
