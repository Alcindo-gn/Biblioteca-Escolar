<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BiblioTech - Sistema de Gerenciamento de Biblioteca</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        navy: {
                            800: '#1e293b',
                            900: '#0f172a',
                            950: '#020617',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- Toast Notification Container (Substitui alert/confirm) -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Top Navigation Bar -->
    <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Brand -->
                <div class="flex items-center gap-3">
                    <div class="bg-amber-500 text-slate-900 p-2 rounded-xl shadow-md">
                        <i class="fa-solid fa-book-open-reader text-xl"></i>
                    </div>
                    <div>
                        <span class="font-bold text-xl tracking-tight text-white">Biblio<span class="text-amber-400">Tech</span></span>
                        <span class="hidden sm:inline-block text-xs text-slate-400 ml-2 border-l border-slate-700 pl-2">Gestão de Acervo</span>
                    </div>
                </div>

                <!-- Desktop Navigation Tabs -->
                <nav class="hidden md:flex space-x-2" id="desktop-nav">
                    <button onclick="switchTab('dashboard')" data-tab="dashboard" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2 bg-amber-500 text-slate-900 font-semibold">
                        <i class="fa-solid fa-chart-pie"></i> Dashboard
                    </button>
                    <button onclick="switchTab('catalogo')" data-tab="catalogo" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2">
                        <i class="fa-solid fa-book"></i> Catálogo
                    </button>
                    <button onclick="switchTab('emprestimos')" data-tab="emprestimos" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2">
                        <i class="fa-solid fa-hand-holding-hand"></i> Empréstimos
                        <span id="nav-badge-loans" class="bg-amber-500/20 text-amber-400 text-xs px-2 py-0.5 rounded-full">0</span>
                    </button>
                    <button onclick="switchTab('leitores')" data-tab="leitores" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors flex items-center gap-2">
                        <i class="fa-solid fa-users"></i> Leitores
                    </button>
                </nav>

                <!-- Quick Action / Reset Demo -->
                <div class="flex items-center gap-2">
                    <button onclick="openConfirmModal('Restaurar Dados', 'Deseja restaurar os dados iniciais de demonstração? Todas as alterações atuais serão substituídas.', resetDemoData)" title="Restaurar dados de exemplo" class="text-xs text-slate-400 hover:text-amber-400 px-3 py-2 rounded-lg hover:bg-slate-800 transition-colors flex items-center gap-1.5">
                        <i class="fa-solid fa-rotate-right"></i>
                        <span class="hidden sm:inline">Resetar Demo</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Bar -->
        <div class="md:hidden border-t border-slate-800 bg-slate-900 px-2 py-2 flex justify-around">
            <button onclick="switchTab('dashboard')" data-tab="dashboard" class="nav-btn-mobile flex-1 py-2 rounded-lg text-xs font-medium flex flex-col items-center gap-1 text-amber-400">
                <i class="fa-solid fa-chart-pie text-base"></i> Início
            </button>
            <button onclick="switchTab('catalogo')" data-tab="catalogo" class="nav-btn-mobile flex-1 py-2 rounded-lg text-xs font-medium flex flex-col items-center gap-1 text-slate-400">
                <i class="fa-solid fa-book text-base"></i> Catálogo
            </button>
            <button onclick="switchTab('emprestimos')" data-tab="emprestimos" class="nav-btn-mobile flex-1 py-2 rounded-lg text-xs font-medium flex flex-col items-center gap-1 text-slate-400">
                <i class="fa-solid fa-hand-holding-hand text-base"></i> Empréstimos
            </button>
            <button onclick="switchTab('leitores')" data-tab="leitores" class="nav-btn-mobile flex-1 py-2 rounded-lg text-xs font-medium flex flex-col items-center gap-1 text-slate-400">
                <i class="fa-solid fa-users text-base"></i> Leitores
            </button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- ==================== ABA 1: DASHBOARD ==================== -->
        <section id="tab-dashboard" class="tab-content space-y-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Visão Geral da Biblioteca</h1>
                    <p class="text-slate-500 text-sm mt-1">Acompanhe os indicadores do acervo e movimentações recentes.</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <button onclick="openBookModal()" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2.5 rounded-xl text-sm font-medium shadow-sm transition-all flex items-center gap-2">
                        <i class="fa-solid fa-plus text-amber-400"></i> Novo Livro
                    </button>
                    <button onclick="switchTab('emprestimos'); document.getElementById('loan-book-select').focus();" class="bg-amber-500 hover:bg-amber-600 text-slate-900 px-4 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition-all flex items-center gap-2">
                        <i class="fa-solid fa-handshake"></i> Novo Empréstimo
                    </button>
                </div>
            </div>

            <!-- KPI Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                <!-- Total de Livros -->
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200/80 flex items-center justify-between hover:shadow-md transition-shadow">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Total de Exemplares</p>
                        <p id="stat-total-books" class="text-3xl font-bold text-slate-900 mt-1">0</p>
                        <p id="stat-unique-titles" class="text-xs text-slate-400 mt-1">0 títulos cadastrados</p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-800 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-books"></i>
                    </div>
                </div>

                <!-- Livros Disponíveis -->
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200/80 flex items-center justify-between hover:shadow-md transition-shadow">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Livros Disponíveis</p>
                        <p id="stat-available-books" class="text-3xl font-bold text-emerald-600 mt-1">0</p>
                        <p class="text-xs text-emerald-600/80 mt-1">Prontos para empréstimo</p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>

                <!-- Livros Emprestados -->
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200/80 flex items-center justify-between hover:shadow-md transition-shadow">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Empréstimos Ativos</p>
                        <p id="stat-loaned-books" class="text-3xl font-bold text-amber-600 mt-1">0</p>
                        <p id="stat-overdue-books" class="text-xs text-slate-500 mt-1">0 em atraso</p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-book-reader"></i>
                    </div>
                </div>

                <!-- Leitores Cadastrados -->
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200/80 flex items-center justify-between hover:shadow-md transition-shadow">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Leitores Cadastrados</p>
                        <p id="stat-total-readers" class="text-3xl font-bold text-blue-700 mt-1">0</p>
                        <p class="text-xs text-slate-400 mt-1">Membros ativos</p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-id-card"></i>
                    </div>
                </div>
            </div>

            <!-- Dashboard Lower Grid: Empréstimos Recentes & Categorias -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Empréstimos em Destaque / Atenção -->
                <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                            <i class="fa-solid fa-clock-rotate-left text-amber-500"></i> Empréstimos Ativos & Prazos
                        </h2>
                        <button onclick="switchTab('emprestimos')" class="text-sm font-medium text-amber-600 hover:text-amber-700">Ver todos &rarr;</button>
                    </div>
                    <div id="dashboard-loans-list" class="space-y-3">
                        <!-- Populado via JS -->
                    </div>
                </div>

                <!-- Distribuição por Categoria -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6">
                    <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-slate-700"></i> Acervo por Categoria
                    </h2>
                    <div id="dashboard-categories-list" class="space-y-4">
                        <!-- Populado via JS -->
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== ABA 2: CATÁLOGO DE LIVROS ==================== -->
        <section id="tab-catalogo" class="tab-content hidden space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Catálogo de Livros</h1>
                    <p class="text-slate-500 text-sm mt-1">Gerencie o acervo, controle exemplares e realize empréstimos rápidos.</p>
                </div>
                <button onclick="openBookModal()" class="bg-amber-500 hover:bg-amber-600 text-slate-900 px-5 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-plus"></i> Adicionar Livro
                </button>
            </div>

            <!-- Barra de Busca e Filtros -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200/80 grid grid-cols-1 md:grid-cols-12 gap-4">
                <div class="md:col-span-6 relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="catalog-search" oninput="renderCatalog()" placeholder="Buscar por título, autor ou ISBN..." class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all">
                </div>
                <div class="md:col-span-3">
                    <select id="catalog-category-filter" onchange="renderCatalog()" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white">
                        <option value="all">Todas as Categorias</option>
                        <!-- Opções dinâmicas -->
                    </select>
                </div>
                <div class="md:col-span-3">
                    <select id="catalog-status-filter" onchange="renderCatalog()" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white">
                        <option value="all">Todos os Status</option>
                        <option value="available">Disponíveis</option>
                        <option value="out">Esgotados</option>
                    </select>
                </div>
            </div>

            <!-- Tabela/Lista de Livros -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-900 text-slate-200 text-xs uppercase tracking-wider">
                                <th class="py-4 px-6 font-semibold">Livro / Autor</th>
                                <th class="py-4 px-4 font-semibold">ISBN</th>
                                <th class="py-4 px-4 font-semibold">Categoria</th>
                                <th class="py-4 px-4 font-semibold text-center">Ano</th>
                                <th class="py-4 px-4 font-semibold text-center">Estoque</th>
                                <th class="py-4 px-4 font-semibold text-center">Status</th>
                                <th class="py-4 px-6 font-semibold text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="catalog-table-body" class="divide-y divide-slate-100 text-sm">
                            <!-- Linhas geradas via JS -->
                        </tbody>
                    </table>
                </div>
                <div id="catalog-empty-state" class="hidden py-12 text-center">
                    <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-slate-100 text-slate-400 mb-3">
                        <i class="fa-solid fa-book-open text-2xl"></i>
                    </div>
                    <h3 class="text-base font-semibold text-slate-900">Nenhum livro encontrado</h3>
                    <p class="text-sm text-slate-500 mt-1">Tente ajustar os filtros ou adicione um novo livro ao catálogo.</p>
                </div>
            </div>
        </section>

        <!-- ==================== ABA 3: EMPRÉSTIMOS E DEVOLUÇÕES ==================== -->
        <section id="tab-emprestimos" class="tab-content hidden space-y-8">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Empréstimos e Devoluções</h1>
                <p class="text-slate-500 text-sm mt-1">Registre retiradas, acompanhe prazos de entrega e dê baixa em devoluções.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Formulário de Novo Empréstimo -->
                <div class="lg:col-span-4">
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 sticky top-24">
                        <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                            <span class="w-8 h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center text-sm">
                                <i class="fa-solid fa-plus"></i>
                            </span>
                            Registrar Empréstimo
                        </h2>
                        <form id="loan-form" onsubmit="handleCreateLoan(event)" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Livro Disponível *</label>
                                <select id="loan-book-select" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white">
                                    <!-- Populado via JS -->
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Leitor *</label>
                                <input type="text" id="loan-reader-input" list="readers-datalist" required placeholder="Selecione ou digite o nome..." class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white">
                                <datalist id="readers-datalist"></datalist>
                                <p class="text-[11px] text-slate-400 mt-1">Você pode escolher um leitor cadastrado ou digitar um nome avulso.</p>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Data Prevista de Devolução *</label>
                                <input type="date" id="loan-due-date" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white">
                            </div>

                            <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3 px-4 rounded-xl shadow-sm transition-all flex items-center justify-center gap-2 mt-2">
                                <i class="fa-solid fa-check text-amber-400"></i> Confirmar Empréstimo
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Listas de Empréstimos Ativos e Histórico -->
                <div class="lg:col-span-8 space-y-6">
                    <!-- Empréstimos Ativos -->
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-hourglass-half text-amber-500"></i> Empréstimos Ativos
                            </h2>
                            <span id="active-loans-count" class="bg-slate-100 text-slate-700 text-xs font-bold px-2.5 py-1 rounded-full">0 ativos</span>
                        </div>
                        <div id="active-loans-list" class="space-y-3">
                            <!-- Populado via JS -->
                        </div>
                    </div>

                    <!-- Histórico de Devoluções -->
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-circle-check text-emerald-600"></i> Histórico de Devoluções
                            </h2>
                            <span id="returned-loans-count" class="text-xs text-slate-400">0 concluídos</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-slate-200 text-xs text-slate-400 uppercase">
                                        <th class="py-2.5 pr-4 font-semibold">Livro</th>
                                        <th class="py-2.5 px-4 font-semibold">Leitor</th>
                                        <th class="py-2.5 px-4 font-semibold">Retirada</th>
                                        <th class="py-2.5 pl-4 font-semibold text-right">Devolvido em</th>
                                    </tr>
                                </thead>
                                <tbody id="returned-loans-table" class="divide-y divide-slate-100 text-sm">
                                    <!-- Populado via JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== ABA 4: LEITORES (MEMBROS) ==================== -->
        <section id="tab-leitores" class="tab-content hidden space-y-6">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Leitores Cadastrados</h1>
                <p class="text-slate-500 text-sm mt-1">Cadastre novos membros e acompanhe a quantidade de livros em posse de cada leitor.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Formulário de Cadastro de Leitor -->
                <div class="lg:col-span-4">
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6">
                        <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                            <span class="w-8 h-8 rounded-lg bg-slate-900 text-amber-400 flex items-center justify-center text-sm">
                                <i class="fa-solid fa-user-plus"></i>
                            </span>
                            Cadastrar Leitor
                        </h2>
                        <form id="reader-form" onsubmit="handleCreateReader(event)" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Nome Completo *</label>
                                <input type="text" id="reader-name" required placeholder="Ex: Mariana Costa" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">E-mail ou Telefone *</label>
                                <input type="text" id="reader-contact" required placeholder="mariana@email.com ou (11) 99999-0000" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Matrícula / ID *</label>
                                <input type="text" id="reader-registration" required placeholder="Ex: MAT-2025-004" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white">
                            </div>
                            <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-900 font-semibold py-3 px-4 rounded-xl shadow-sm transition-all flex items-center justify-center gap-2">
                                <i class="fa-solid fa-floppy-disk"></i> Salvar Leitor
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Lista de Leitores -->
                <div class="lg:col-span-8">
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
                        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
                            <div class="relative w-full max-w-xs">
                                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input type="text" id="reader-search" oninput="renderReaders()" placeholder="Filtrar leitor..." class="w-full pl-8 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
                            </div>
                            <span id="readers-total-badge" class="text-xs font-semibold text-slate-500">0 membros</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                                        <th class="py-3.5 px-6 font-semibold">Leitor</th>
                                        <th class="py-3.5 px-4 font-semibold">Matrícula</th>
                                        <th class="py-3.5 px-4 font-semibold">Contato</th>
